{
  "name": "mototrace",
  "version": "0.3.0",
  "description": "MotoTrace - A self-tracking desktop application",
  "main": "out/main/index.js",
  "author": "MotoTrace",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "seed:dev": "node scripts/seed-dev-data.mjs",
    "postinstall": "node scripts/patch-brace-expansion.cjs",
    "clean": "node scripts/clean.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run clean && npm run build && electron-builder",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "audit": "npm audit --audit-level=high",
    "verify:version": "node scripts/verify-version.mjs",
    "check": "npm run lint && npm run test && npm run audit && npm run verify:version && npm run build"
  },
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.7.6",
    "@tiptap/extension-character-count": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "date-fns": "^3.6.0",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^5.2.0",
    "brace-expansion": "5.0.12",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.mototrace.app",
    "productName": "MotoTrace",
    "artifactName": "MotoTrace-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "logo.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "removeDefaultUninstallWelcomePage": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "include": "build/installer.nsh"
    }
  }
}
